{
  "name": "open-shed-card-engine",
  "version": "1.6.3",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NiyiOke/open-shed-card-engine.git"
  },
  "homepage": "https://open-shed-card-game.neo-dabuda.chatgpt.site",
  "bugs": {
    "url": "https://github.com/NiyiOke/open-shed-card-engine/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run build",
    "test:unit": "npm run test:contribution-policy && node --import tsx --test tests/*.test.ts",
    "test:contribution-policy": "node --test tests/ai-contribution-attestation.test.mjs",
    "test:v11-browser": "node scripts/v11-browser-acceptance.mjs",
    "test:v15-lifecycle": "node scripts/v15-room-lifecycle-acceptance.mjs",
    "test:v15-discovery": "node scripts/v15-discovery-acceptance.mjs",
    "test:v15-chat": "node scripts/v15-chat-acceptance.mjs",
    "test:v16-continuity": "node scripts/v16-continuity-acceptance.mjs",
    "test:v161-rules": "node scripts/v161-rules-clarity-acceptance.mjs",
    "test:v162-lobby": "node scripts/v162-lobby-presence-acceptance.mjs",
    "test:realtime": "node --import tsx scripts/realtime-worker-acceptance.mjs",
    "test:realtime-sites": "node --import tsx scripts/realtime-sites-integration-acceptance.mjs",
    "test:performance": "node --import tsx scripts/check-client-performance.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "0.45.2",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.58.0",
    "@cloudflare/workers-types": "5.20260924.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "playwright": "^1.62.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.6",
    "vite": "8.3.0",
    "wrangler": "4.137.0"
  },
  "type": "module"
}
